# Public Neon Auth (Managed Better Auth) endpoint for this database branch
NEXT_PUBLIC_NEON_AUTH_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
# Public Neon Data API (PostgREST) endpoint for this database branch
NEXT_PUBLIC_NEON_DATA_API_URL=https://<endpoint>.apirest.<region>.aws.neon.tech/<db>/rest/v1
# Direct Postgres connection string. Only needed for running the SQL migration / type generation. Never commit.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
